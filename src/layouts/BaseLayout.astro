---
import { languagePaths } from "../i18n/routes";

interface Props {
  title: string;
  description: string;
  image?: string;
}

const {
  title,
  description,
  image = "/images/hero-ai-coaching.png",
} = Astro.props;
const en = Astro.url.pathname.startsWith("/en/") || Astro.url.pathname === "/en";
const lang = en ? "en" : "tr";
const paths = languagePaths(Astro.url.pathname);
const canonical = new URL(Astro.url.pathname, "https://perda.com.tr");
const navItems = en ? [
  { href: "/en/#nasil-calisir", label: "How it works" },
  { href: "/en/coaching-topics/", label: "Topics" },
  { href: "/en/#seans", label: "Coaching" },
  { href: "/en/pricing/", label: "Pricing" },
  { href: "/en/blog/", label: "Blog" },
  { href: "/en/#iletisim", label: "Contact" },
] : [
  { href: "/#nasil-calisir", label: "Nasıl Çalışır" },
  { href: "/kocluk-konulari", label: "Konular" },
  { href: "/#seans", label: "Koçluk Seansı" },
  { href: "/fiyatlar", label: "Fiyatlar" },
  { href: "/blog", label: "Blog" },
  { href: "/#iletisim", label: "İletişim" },
];
const contactUrl =
  `https://mail.google.com/mail/?view=cm&fs=1&to=coach@perda.com.tr&su=${encodeURIComponent(en ? "About coaching sessions" : "Koçluk seansı hakkında")}`;
const signupUrl = en
  ? "https://coach.perda.com.tr/en/accounts/signup/"
  : "https://coach.perda.com.tr/accounts/signup/";
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="tr" href={new URL(paths.tr, "https://perda.com.tr")} />
    <link rel="alternate" hreflang="en" href={new URL(paths.en, "https://perda.com.tr")} />
    <link rel="alternate" hreflang="x-default" href={new URL(paths.tr, "https://perda.com.tr")} />
    <meta property="og:locale" content={en ? "en_GB" : "tr_TR"} />
    <meta property="og:locale:alternate" content={en ? "tr_TR" : "en_GB"} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(image, "https://perda.com.tr")} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" type="image/png" href="/images/perda-logo.png" />
    <link rel="preload" as="image" href="/images/hero-ai-coaching.png" />
    <script async src="https://www.googletagmanager.com/gtag/js?id=AW-10967056363"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag("js", new Date());

      gtag("config", "AW-10967056363");
    </script>
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href={en ? "/en/" : "/"} aria-label={en ? "Perda Human Resources home" : "Perda İnsan Kaynakları ana sayfa"}>
        <img src="/images/perda-logo.png" alt={en ? "Perda Human Resources" : "Perda İnsan Kaynakları"} width="152" height="48" />
      </a>
      <nav aria-label={en ? "Main navigation" : "Ana menü"}>
        {navItems.map((item) => <a href={item.href}>{item.label}</a>)}
      </nav>
      <div class="header-actions">
        <div class="language-switch" role="group" aria-label={en ? "Language" : "Dil seçimi"}>
          <a href={paths.tr} lang="tr" hreflang="tr" aria-label="Türkçe" aria-current={!en ? "page" : undefined}><img src="/images/flag-tr.svg" alt="" width="21" height="14" aria-hidden="true" />TR</a>
          <a href={paths.en} lang="en" hreflang="en" aria-label="English" aria-current={en ? "page" : undefined}><img src="/images/flag-en.svg" alt="" width="21" height="14" aria-hidden="true" />EN</a>
        </div>
        <a class="header-cta" href={signupUrl} target="_blank" rel="noopener noreferrer">{en ? "Coaching Session" : "Koçluk Seansı"}</a>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <div>
        <img src="/images/perda-logo.png" alt={en ? "Perda Human Resources" : "Perda İnsan Kaynakları"} width="132" height="42" />
        <p>{en ? "A coaching app that helps you clarify what is on your mind and see your next step." : "Kafanıza takılan konuları netleştirmenize ve bir sonraki adımı görmenize yardımcı olan koçluk uygulaması."}</p>
        <p>{en ? "The Perda brand is owned by Kobiai Yapay Zeka Çözümleri Ltd Şti." : "Perda markası Kobiai Yapay Zeka Çözümleri Ltd Şti'ne aittir."}</p>
      </div>
      <div>
        <strong>{en ? "Contact" : "İletişim"}</strong>
        <a href={contactUrl} target="_blank" rel="noopener noreferrer">coach@perda.com.tr</a>
        <span>{en ? "Akasya Tower, Acıbadem, Üsküdar / Istanbul" : "Akasya Kule, Acıbadem Mah. Üsküdar / İstanbul"}</span>
      </div>
      <div>
        <strong>{en ? "Legal" : "Yasal"}</strong>
        <a href={en ? "/en/data-protection/" : "/kvkk/"}>{en ? "Personal Data Protection (KVKK)" : "KVKK"}</a>
        <a href={en ? "/en/privacy-policy/" : "/gizlilik-politikasi/"}>{en ? "Privacy Policy" : "Gizlilik Politikası"}</a>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --ink: #14201f;
    --muted: #5c6866;
    --line: #dfe7e3;
    --paper: #fbfcf9;
    --soft: #eef4ef;
    --teal: #0f635d;
    --teal-dark: #0a403d;
    --coral: #c9664a;
    --sage: #779b82;
    --white: #ffffff;
    --shadow: 0 18px 50px rgba(20, 32, 31, 0.12);
    font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  }

  * {
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
  }

  body {
    margin: 0;
    color: var(--ink);
    background: var(--paper);
    line-height: 1.6;
  }

  img {
    display: block;
    max-width: 100%;
    height: auto;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  p {
    margin: 0;
    color: var(--muted);
  }

  h1,
  h2,
  h3 {
    margin: 0;
    line-height: 1.08;
    letter-spacing: 0;
  }

  h1 {
    font-size: clamp(2.7rem, 7vw, 5.9rem);
    max-width: 980px;
  }

  h2 {
    font-size: clamp(2rem, 4vw, 3.5rem);
    max-width: 780px;
  }

  h3 {
    font-size: 1.25rem;
  }

  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding: 16px clamp(18px, 5vw, 64px);
    border-bottom: 1px solid rgba(223, 231, 227, 0.88);
    background: rgba(251, 252, 249, 0.92);
    backdrop-filter: blur(16px);
  }

  .header-actions { display: flex; align-items: center; gap: 12px; margin-left: auto; }
  .language-switch { display: flex; gap: 2px; padding: 3px; border: 1px solid var(--line); border-radius: 6px; }
  .language-switch a { display: inline-flex; align-items: center; justify-content: center; gap: 5px; padding: 0 7px; min-width: 36px; min-height: 36px; font-size: 0.82rem; font-weight: 750; border-radius: 4px; }
  .language-switch img { width: 21px; height: 14px; object-fit: cover; border-radius: 2px; flex-shrink: 0; }
  .language-switch a[aria-current="page"] { color: white; background: var(--teal); }
  a:focus-visible, summary:focus-visible { outline: 3px solid var(--coral); outline-offset: 3px; }

  .brand {
    flex: 0 0 auto;
  }

  .brand img,
  .site-footer img {
    object-fit: contain;
  }

  nav {
    display: flex;
    align-items: center;
    gap: 22px;
    color: #31413f;
    font-size: 0.94rem;
    font-weight: 650;
  }

  nav a:hover,
  .site-footer a:hover {
    color: var(--teal);
  }

  .header-cta,
  .button,
  .button-secondary {
    display: inline-flex;
    min-height: 46px;
    align-items: center;
    justify-content: center;
    border-radius: 6px;
    padding: 0 18px;
    font-weight: 750;
    transition: transform 160ms ease, background 160ms ease, border-color 160ms ease;
  }

  .header-cta,
  .button {
    color: var(--white);
    background: var(--teal);
  }

  .button-secondary {
    border: 1px solid var(--line);
    background: rgba(255, 255, 255, 0.82);
  }

  .header-cta:hover,
  .button:hover,
  .button-secondary:hover {
    transform: translateY(-1px);
  }

  .header-cta:hover,
  .button:hover {
    background: var(--teal-dark);
  }

  section,
  .section {
    padding: clamp(64px, 9vw, 118px) clamp(18px, 5vw, 64px);
  }

  .container {
    width: min(1160px, 100%);
    margin: 0 auto;
  }

  .eyebrow {
    margin-bottom: 14px;
    color: var(--coral);
    font-size: 0.8rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .lead {
    max-width: 760px;
    margin-top: 22px;
    font-size: clamp(1.08rem, 2vw, 1.3rem);
  }

  .grid {
    display: grid;
    gap: 18px;
  }

  .card {
    border: 1px solid var(--line);
    border-radius: 8px;
    background: var(--white);
    box-shadow: 0 8px 24px rgba(20, 32, 31, 0.06);
  }

  .site-footer {
    display: grid;
    grid-template-columns: 1.4fr 1fr 0.7fr;
    gap: 30px;
    padding: 42px clamp(18px, 5vw, 64px);
    border-top: 1px solid var(--line);
    background: #f3f7f3;
  }

  .site-footer > div {
    display: grid;
    align-content: start;
    gap: 10px;
  }

  .site-footer strong {
    font-size: 0.92rem;
  }

  @media (max-width: 1180px) {
    .site-header {
      align-items: flex-start;
      flex-wrap: wrap;
    }

    nav {
      order: 3;
      width: 100%;
      overflow-x: auto;
      padding-bottom: 4px;
      gap: 16px;
      white-space: nowrap;
    }

    .site-footer {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 560px) {
    .header-actions { gap: 6px; }
    .language-switch a { min-width: 30px; }
    .site-header {
      gap: 12px;
    }

    .brand img {
      width: 126px;
    }

    .header-cta {
      min-height: 40px;
      padding: 0 12px;
      font-size: 0.86rem;
    }
  }
</style>
