---
interface Props {
  title: string;
  description: string;
  image?: string;
}

const {
  title,
  description,
  image = "/images/hero-ai-coaching.png",
} = Astro.props;
const canonical = new URL(Astro.url.pathname, "https://perda.com.tr");
const navItems = [
  { href: "/#nasil-calisir", label: "Nasıl Çalışır" },
  { href: "/kocluk-konulari", label: "Konular" },
  { href: "/#seans", label: "Koçluk Seansı" },
  { href: "/fiyatlar", label: "Fiyatlar" },
  { href: "/blog", label: "Blog" },
  { href: "/#iletisim", label: "İletişim" },
];
const contactUrl =
  "https://mail.google.com/mail/?view=cm&fs=1&to=coach@perda.com.tr&su=Ko%C3%A7luk%20seans%C4%B1%20hakk%C4%B1nda";
const signupUrl = "https://coach.perda.com.tr/accounts/signup/";
---

<!doctype html>
<html lang="tr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(image, "https://perda.com.tr")} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" type="image/png" href="/images/perda-logo.png" />
    <link rel="preload" as="image" href="/images/hero-ai-coaching.png" />
    <script async src="https://www.googletagmanager.com/gtag/js?id=AW-10967056363"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag("js", new Date());

      gtag("config", "AW-10967056363");
    </script>
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="/" aria-label="Perda İnsan Kaynakları ana sayfa">
        <img src="/images/perda-logo.png" alt="Perda İnsan Kaynakları" width="152" height="48" />
      </a>
      <nav aria-label="Ana menü">
        {navItems.map((item) => <a href={item.href}>{item.label}</a>)}
      </nav>
      <a class="header-cta" href={signupUrl} target="_blank" rel="noopener noreferrer">Koçluk Seansı</a>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <div>
        <img src="/images/perda-logo.png" alt="Perda İnsan Kaynakları" width="132" height="42" />
        <p>Kafanıza takılan konuları netleştirmenize ve bir sonraki adımı görmenize yardımcı olan koçluk uygulaması.</p>
        <p>Perda markası Kobiai Yapay Zeka Çözümleri Ltd Şti'ne aittir.</p>
      </div>
      <div>
        <strong>İletişim</strong>
        <a href={contactUrl} target="_blank" rel="noopener noreferrer">coach@perda.com.tr</a>
        <span>Akasya Kule, Acıbadem Mah. Üsküdar / İstanbul</span>
      </div>
      <div>
        <strong>Yasal</strong>
        <a href="/kvkk">KVKK</a>
        <a href="/gizlilik-politikasi">Gizlilik Politikası</a>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --ink: #14201f;
    --muted: #5c6866;
    --line: #dfe7e3;
    --paper: #fbfcf9;
    --soft: #eef4ef;
    --teal: #0f635d;
    --teal-dark: #0a403d;
    --coral: #c9664a;
    --sage: #779b82;
    --white: #ffffff;
    --shadow: 0 18px 50px rgba(20, 32, 31, 0.12);
    font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  }

  * {
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
  }

  body {
    margin: 0;
    color: var(--ink);
    background: var(--paper);
    line-height: 1.6;
  }

  img {
    display: block;
    max-width: 100%;
    height: auto;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  p {
    margin: 0;
    color: var(--muted);
  }

  h1,
  h2,
  h3 {
    margin: 0;
    line-height: 1.08;
    letter-spacing: 0;
  }

  h1 {
    font-size: clamp(2.7rem, 7vw, 5.9rem);
    max-width: 980px;
  }

  h2 {
    font-size: clamp(2rem, 4vw, 3.5rem);
    max-width: 780px;
  }

  h3 {
    font-size: 1.25rem;
  }

  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding: 16px clamp(18px, 5vw, 64px);
    border-bottom: 1px solid rgba(223, 231, 227, 0.88);
    background: rgba(251, 252, 249, 0.92);
    backdrop-filter: blur(16px);
  }

  .brand {
    flex: 0 0 auto;
  }

  .brand img,
  .site-footer img {
    object-fit: contain;
  }

  nav {
    display: flex;
    align-items: center;
    gap: 22px;
    color: #31413f;
    font-size: 0.94rem;
    font-weight: 650;
  }

  nav a:hover,
  .site-footer a:hover {
    color: var(--teal);
  }

  .header-cta,
  .button,
  .button-secondary {
    display: inline-flex;
    min-height: 46px;
    align-items: center;
    justify-content: center;
    border-radius: 6px;
    padding: 0 18px;
    font-weight: 750;
    transition: transform 160ms ease, background 160ms ease, border-color 160ms ease;
  }

  .header-cta,
  .button {
    color: var(--white);
    background: var(--teal);
  }

  .button-secondary {
    border: 1px solid var(--line);
    background: rgba(255, 255, 255, 0.82);
  }

  .header-cta:hover,
  .button:hover,
  .button-secondary:hover {
    transform: translateY(-1px);
  }

  .header-cta:hover,
  .button:hover {
    background: var(--teal-dark);
  }

  section,
  .section {
    padding: clamp(64px, 9vw, 118px) clamp(18px, 5vw, 64px);
  }

  .container {
    width: min(1160px, 100%);
    margin: 0 auto;
  }

  .eyebrow {
    margin-bottom: 14px;
    color: var(--coral);
    font-size: 0.8rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .lead {
    max-width: 760px;
    margin-top: 22px;
    font-size: clamp(1.08rem, 2vw, 1.3rem);
  }

  .grid {
    display: grid;
    gap: 18px;
  }

  .card {
    border: 1px solid var(--line);
    border-radius: 8px;
    background: var(--white);
    box-shadow: 0 8px 24px rgba(20, 32, 31, 0.06);
  }

  .site-footer {
    display: grid;
    grid-template-columns: 1.4fr 1fr 0.7fr;
    gap: 30px;
    padding: 42px clamp(18px, 5vw, 64px);
    border-top: 1px solid var(--line);
    background: #f3f7f3;
  }

  .site-footer > div {
    display: grid;
    align-content: start;
    gap: 10px;
  }

  .site-footer strong {
    font-size: 0.92rem;
  }

  @media (max-width: 920px) {
    .site-header {
      align-items: flex-start;
      flex-wrap: wrap;
    }

    nav {
      order: 3;
      width: 100%;
      overflow-x: auto;
      padding-bottom: 4px;
      gap: 16px;
      white-space: nowrap;
    }

    .site-footer {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 560px) {
    .site-header {
      gap: 12px;
    }

    .brand img {
      width: 126px;
    }

    .header-cta {
      min-height: 40px;
      padding: 0 12px;
      font-size: 0.86rem;
    }
  }
</style>
