---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const getPostSlug = (id: string) => id.replace(/\.md$/, "");
---

<BaseLayout
  title="Blog | Perda İnsan Kaynakları"
  description="Yapay zeka ile koçluk, kariyer, liderlik, ilişki koçluğu ve kişisel gelişim üzerine Perda İnsan Kaynakları blog yazıları."
>
  <section class="blog-hero">
    <div class="container">
      <p class="eyebrow">Blog</p>
      <h1>Koçluk, yapay zeka ve gelişim üzerine notlar</h1>
      <p class="lead">
        Bireysel ve kurumsal hedefler, ilişki koçluğu, kariyer kararları ve yapay zeka destekli gelişim deneyimi hakkında örnek içerikler.
      </p>
    </div>
  </section>
  <section class="blog-list-section">
    <div class="container blog-list">
      {posts.map((post) => (
        <article class="card post-row">
          <a href={`/blog/${getPostSlug(post.id)}/`}>
            <img src={post.data.image} alt="" width="900" height="506" loading="lazy" />
            <div>
              <span>{post.data.category} · {post.data.readTime}</span>
              <h2>{post.data.title}</h2>
              <p>{post.data.description}</p>
            </div>
          </a>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .blog-hero {
    background: var(--soft);
  }

  .blog-list {
    display: grid;
    gap: 18px;
  }

  .post-row {
    overflow: hidden;
  }

  .post-row a {
    display: grid;
    grid-template-columns: 320px 1fr;
    gap: 0;
  }

  .post-row img {
    width: 100%;
    height: 100%;
    min-height: 230px;
    object-fit: cover;
  }

  .post-row div {
    display: grid;
    align-content: center;
    gap: 12px;
    padding: 28px;
  }

  .post-row span {
    color: var(--coral);
    font-size: 0.82rem;
    font-weight: 800;
  }

  .post-row h2 {
    font-size: clamp(1.45rem, 3vw, 2.2rem);
  }

  @media (max-width: 760px) {
    .post-row a {
      grid-template-columns: 1fr;
    }
  }
</style>
