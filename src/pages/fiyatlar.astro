---
import BaseLayout from "../layouts/BaseLayout.astro";

const signupUrl = "https://coach.perda.com.tr/accounts/signup/";

const plans = [
  {
    label: "4 seans",
    price: "790 TL",
    description: "Kısa süreli hedefler, karar anları ve düzenli farkındalık çalışmaları için.",
    sessions: "4 seans",
    validity: "2 ay geçerli",
    features: ["Her seans sonrası diyalog", "Gerçek hikayelerle ilham", "Seans aktarımı"],
  },
  {
    label: "10 seans",
    price: "1790 TL",
    description: "Daha uzun soluklu gelişim hedefleri ve tekrar eden koçluk ihtiyacı için.",
    sessions: "10 seans",
    validity: "4 ay geçerli",
    featured: true,
    features: ["Her seans sonrası diyalog", "Gerçek hikayelerle ilham", "Seans aktarımı"],
  },
  {
    label: "75 seans",
    price: "8990 TL",
    description: "Ekipler, yoğun kullanım ve uzun dönemli gelişim programları için.",
    sessions: "75 seans",
    validity: "6 ay geçerli",
    features: ["Her seans sonrası diyalog", "Gerçek hikayelerle ilham", "Seans aktarımı"],
  },
];

const sharedFeatures = [
  "Yapay zeka koçluk görüşmesi",
  "7-10 soruda odak netleştirme",
  "Seans yazışmalarını silebilme",
  "Her seans sonrası diyalog",
  "Gerçek hikayelerle ilham",
  "Seans aktarımı",
];
---

<BaseLayout
  title="Fiyatlar | Perda İnsan Kaynakları"
  description="Perda yapay zeka koçluk uygulaması için 4 seans, 10 seans ve 75 seans paketlerini inceleyin. Fiyatlara KDV dahildir."
>
  <section class="pricing-hero">
    <div class="container">
      <p class="eyebrow">Fiyatlar</p>
      <h1>İhtiyacınıza uygun koçluk planını seçin.</h1>
      <p class="lead">
        Her pakette tüm özellikler aynıdır. İhtiyacınıza göre 4, 10 veya 75 seanslık koçluk paketlerinden birini seçebilirsiniz.
      </p>
    </div>
  </section>

  <section class="pricing-section">
    <div class="container pricing-note">
      <strong>Fiyatlara KDV dahildir.</strong>
      <span>Koçluk uygulamasındaki ilk seansınızdan memnun kalmazsanız satın alma tarihinden itibaren 14 gün içinde ödemenin tamamını geri alabilirsiniz. Tekrar eden ödeme veya abonelik yoktur.</span>
    </div>
    <div class="container pricing-grid">
      {plans.map((plan) => (
        <article class={`price-card ${plan.featured ? "price-card-featured" : ""}`}>
          {plan.featured && <span class="popular-label">Öne çıkan</span>}
          <h2>{plan.label}</h2>
          <div class="price-row">
            <strong>{plan.price}</strong>
          </div>
          <p>{plan.description}</p>
          <span class="session-count">{plan.sessions}</span>
          <span class="validity">{plan.validity}</span>
          <ul>
            {plan.features.map((feature) => <li>{feature}</li>)}
          </ul>
          <a class="button" href={signupUrl} target="_blank" rel="noopener noreferrer">Hesap oluştur</a>
        </article>
      ))}
    </div>
  </section>

  <section class="features-section">
    <div class="container split-heading">
      <div>
        <p class="eyebrow">Tüm Kullanıcılar</p>
        <h2>Tek kullanıcı tipi, aynı güçlü özellikler.</h2>
      </div>
      <p>
        Yeni hesaplar aynı kapsamla oluşturulur. Tüm paketlerde yapay zeka koçluk görüşmesi, seans sonrası diyalog, gerçek hikayeler ve seans aktarımı yer alır.
      </p>
    </div>
    <div class="container shared-feature-grid">
      {sharedFeatures.map((feature) => (
        <article class="shared-feature">
          <span>✓</span>
          <p>{feature}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="pricing-footer-section">
    <div class="container pricing-footer">
      <div>
        <p class="eyebrow">Memnuniyet İadesi</p>
        <h2>İlk seans sonrası memnun kalmazsanız ödemenizi geri alın.</h2>
      </div>
      <p>
        Koçluk seansınızı tamamladıktan sonra memnun kalmazsanız 14 gün içinde tam iade hakkınız vardır. Abonelik yoktur; seans paketlerini ihtiyaç duydukça satın alırsınız.
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .pricing-hero {
    background: var(--soft);
  }

  .pricing-section {
    background: var(--paper);
  }

  .pricing-note {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 18px;
    align-items: center;
    justify-content: center;
    margin-bottom: 24px;
    border: 1px solid #f0d7b2;
    border-radius: 8px;
    padding: 14px 18px;
    background: #fff4e5;
    color: #594018;
  }

  .pricing-note strong {
    color: var(--coral);
  }

  .pricing-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 18px;
  }

  .price-card {
    position: relative;
    display: flex;
    min-height: 470px;
    flex-direction: column;
    gap: 14px;
    border: 1px solid var(--line);
    border-radius: 8px;
    padding: 24px;
    background: white;
    box-shadow: 0 8px 24px rgba(20, 32, 31, 0.06);
  }

  .price-card-featured {
    border-color: var(--teal);
    box-shadow: var(--shadow);
  }

  .popular-label {
    align-self: flex-start;
    border-radius: 999px;
    padding: 6px 10px;
    color: white;
    background: var(--teal);
    font-size: 0.78rem;
    font-weight: 850;
  }

  .price-card h2 {
    font-size: 1.55rem;
  }

  .price-row {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    align-items: baseline;
  }

  .price-row s {
    color: var(--muted);
    font-weight: 700;
  }

  .price-row strong {
    color: var(--teal-dark);
    font-size: 2rem;
    line-height: 1;
  }

  .session-count {
    color: var(--coral);
    font-weight: 850;
  }

  .validity {
    color: var(--teal-dark);
    font-weight: 800;
  }

  .price-card ul {
    display: grid;
    gap: 9px;
    margin: 0 0 8px;
    padding-left: 20px;
    color: #344340;
  }

  .price-card .button {
    margin-top: auto;
  }

  .features-section {
    background: var(--soft);
  }

  .shared-feature-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
  }

  .shared-feature {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 12px;
    align-items: start;
    border: 1px solid var(--line);
    border-radius: 8px;
    padding: 18px;
    background: white;
  }

  .shared-feature span {
    color: var(--coral);
    font-weight: 900;
  }

  .shared-feature p {
    color: var(--teal-dark);
    font-weight: 800;
  }

  .pricing-footer-section {
    background: #122321;
  }

  .pricing-footer {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: 30px;
    align-items: center;
  }

  .pricing-footer h2,
  .pricing-footer p {
    color: white;
  }

  @media (max-width: 1050px) {
    .pricing-grid,
    .shared-feature-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 680px) {
    .pricing-grid,
    .shared-feature-grid,
    .pricing-footer {
      grid-template-columns: 1fr;
    }

    .price-card {
      min-height: auto;
    }
  }
</style>
