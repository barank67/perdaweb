---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const getPostSlug = (id: string) => id.replace(/\.md$/, "");

const emailSubject = "Koçluk seansı hakkında";
const emailBody =
  "Merhaba Perda İnsan Kaynakları,\n\nKoçluk seansı hakkında bilgi almak istiyorum.\n\nAd Soyad:\nTelefon:\nKafama takılan konu:\n";
const contactUrl = `https://mail.google.com/mail/?view=cm&fs=1&to=coach@perda.com.tr&su=${encodeURIComponent(emailSubject)}&body=${encodeURIComponent(emailBody)}`;
const signupUrl = "https://coach.perda.com.tr/accounts/signup/";

const painPoints = [
  "Hayır diyemiyorum.",
  "Zor konuşmaları erteliyorum.",
  "Karar veremiyorum.",
  "İşim bütün hayatımı kaplıyor.",
  "Başarılı olmama rağmen yetersiz hissediyorum.",
  "İlişkilerimde ihtiyaçlarımı söyleyemiyorum.",
  "Yeni alışkanlıklara başlayıp sürdüremiyorum.",
  "Hayatımda değişiklik istiyorum ama ilk adımı bulamıyorum.",
];

const topicGroups = [
  "Sınır koyma ve hayır diyebilme",
  "Erteleme ve harekete geçme",
  "Kariyer yönü ve görünürlük",
  "Karar verme ve belirsizlik",
  "Özgüven ve yetersizlik hissi",
  "İlişki koçluğu ve zor konuşmalar",
  "İş-yaşam dengesi ve tükenmişlik",
  "Alışkanlık değiştirme",
  "Para, risk ve girişim kararları",
  "Anlam arayışı ve yaşam yönü",
];

const sessionGains = [
  "Kafanızdaki konuyu tek odağa indirirsiniz.",
  "Duygunuzun arkasındaki ihtiyacı fark edersiniz.",
  "Kontrolünüzde olan küçük adımı görürsünüz.",
  "Soruna sıkışmak yerine çözüm yönüne geçersiniz.",
  "Konuya dışarıdan bakmayı denersiniz.",
  "Benzer deneyimlerden ilham alırsınız.",
  "Eski alışkanlığı yeni bir davranışla değiştirmek için uygulamamızdan destek alırsınız.",
];

const faqs = [
  {
    question: "Perda bana tavsiye mi verir?",
    answer:
      "Hayır. Aynı sorunu yaşayan herkesin çözümü aynı değildir. Perda size akıl vermek yerine, kendi cevabınızı bulmanız için doğru sorularla düşünme alanı açar.",
  },
  {
    question: "Yapay zeka burada ne yapıyor?",
    answer:
      "Yapay zeka, görüşmeyi yapılandırmak ve cevaplarınıza göre takip soruları üretmek için kullanılır. Ana amaç teknoloji göstermek değil, kafanızdaki konuyu daha anlaşılır hale getirmektir.",
  },
  {
    question: "İlk seans sonrası memnun kalmazsam ne olur?",
    answer:
      "Koçluk uygulamasındaki ilk seansınızdan memnun kalmazsanız satın alma tarihinden itibaren 14 gün içinde ödemenin tamamını geri alabilirsiniz. Tekrar eden ödeme ve abonelik yoktur.",
  },
];
---

<BaseLayout
  title="Perda | Koçluk Seansı"
  description="Perda, kafanıza takılan konuyu netleştirmenize, duygunuzun arkasındaki ihtiyacı fark etmenize ve bir sonraki adımı görmenize yardımcı olan koçluk uygulamasıdır."
>
  <section class="hero">
    <div class="hero-copy">
      <p class="eyebrow">Perda İnsan Kaynakları</p>
      <h1>Artık kafanıza takılan her konunun bir çözümü var</h1>
      <p class="lead">
        Hayır diyememek, zor konuşmaları ertelemek, karar verememek, ilişkilerde sıkışmak, kariyer yönünü bulamamak veya eski alışkanlıklara geri dönmek... Perda, zihninizde dönen konuyu yapılandırmanıza ve bir sonraki adımı görmenize yardımcı olan koçluk uygulamasıdır.
      </p>
      <div class="hero-actions">
        <a class="button" href={signupUrl} target="_blank" rel="noopener noreferrer">Koçluk Seansı Al</a>
        <a class="button-secondary" href="/kocluk-konulari">Koçluk konularını incele</a>
      </div>
    </div>
    <div class="hero-media">
      <img src="/images/hero-ai-coaching.png" alt="Koçluk seansı için sakin bir çalışma alanı" width="1536" height="1024" />
    </div>
  </section>

  <section class="message-band">
    <div class="container message-inner">
      <h2>Hayatınızda değiştirmek istediğiniz bir şey var mı?</h2>
      <p>
        Bazen sorun büyük olduğu için değil, zihinde çok uzun süre yalnız taşındığı için ağırlaşır. Perda, o konuyu dışarı alıp daha sakin bir yerden görmenize yardım eder.
      </p>
    </div>
  </section>

  <section>
    <div class="container split-heading">
      <div>
        <p class="eyebrow">Kendinizi Burada Buluyor Musunuz?</p>
        <h2>Kafaya takılan konular çoğu zaman tanıdık cümlelerle başlar.</h2>
      </div>
      <p>
        Bir koçluk seansı, tek bir cümleyle başlayan dağınık düşünceyi daha anlaşılır bir odağa çevirebilir.
      </p>
    </div>
    <div class="container pain-grid">
      {painPoints.map((point) => <article class="pain-card"><p>{point}</p></article>)}
    </div>
  </section>

  <section id="kapsam" class="soft-section">
    <div class="container split-heading">
      <div>
        <p class="eyebrow">Koçluk Konuları</p>
        <h2>Koçluk hangi konularda yardımcı olabilir?</h2>
      </div>
      <p>
        Sınır koymadan kariyer yönüne, ilişkilerden alışkanlıklara kadar kişisel olarak taşıdığınız birçok konuda seans başlatabilirsiniz.
      </p>
    </div>
    <div class="container topic-grid">
      {topicGroups.map((topic) => <span>{topic}</span>)}
    </div>
    <div class="container topic-action">
      <a class="button-secondary" href="/kocluk-konulari">50 örnek konuyu gör</a>
    </div>
  </section>

  <section id="nasil-calisir" class="outcomes-section">
    <div class="container split-heading">
      <div>
        <p class="eyebrow">Seansta Ne Kazanırsınız?</p>
        <h2>Önemli olan özellik değil, sizde bıraktığı değişimdir.</h2>
      </div>
      <p>
        Yapay zeka arka planda görüşmeyi yapılandırır. Siz ise kafanızdaki konuyu, duygunuzu ve kontrolünüzdeki küçük adımı daha net görmeye başlarsınız.
      </p>
    </div>
    <div class="container outcomes-list">
      {sessionGains.map((gain) => <article><p>{gain}</p></article>)}
    </div>
  </section>

  <section class="habit-section">
    <div class="container habit-panel">
      <div>
        <p class="eyebrow">Alışkanlık Desteği</p>
        <h2>Fark ettiğiniz şeyi günlük hayata taşıyın.</h2>
      </div>
      <div>
        <blockquote>“Aynı şeyleri yaparak farklı sonuçlar bekleyemeyiz.”</blockquote>
        <p>
          Einstein’a atfedilen bu sözün hatırlattığı gibi, farkındalık davranışa dönüşmediğinde eski döngü devam eder. Koçluk seansında fark ettiğiniz şeyi günlük hayata taşımak için eski alışkanlığı yeni, küçük ve uygulanabilir bir davranışla değiştirmeye yardımcı olan uygulamamızdan destek alabilirsiniz.
        </p>
      </div>
    </div>
  </section>

  <section>
    <div class="container split-heading">
      <div>
        <p class="eyebrow">Tavsiye Değil Koçluk</p>
        <h2>Sizin için doğru olan cevabı sadece siz biliyorsunuz.</h2>
      </div>
      <p>
        Aynı sorunu yaşayan herkesin çözümü aynı değildir. Perda size akıl vermek yerine, kendi cevabınızı bulmanız için doğru sorularla düşünme alanı açar.
      </p>
    </div>
  </section>

  <section class="privacy-section">
    <div class="container privacy-note">
      <div>
        <p class="eyebrow">Güvenlik ve Kontrol</p>
        <h2>Seans ve ödeme kontrolü sizde kalır.</h2>
      </div>
      <p>
        Seans yazışmalarınızı silebilirsiniz. Abonelik yoktur; kredi kartı bilgisi saklamıyoruz. Koçluk uygulamasındaki ilk seansınızdan memnun kalmazsanız satın alma tarihinden itibaren 14 gün içinde ödemenizin tamamını geri alabilirsiniz.
      </p>
    </div>
  </section>

  <section class="faq-section">
    <div class="container split-heading">
      <div>
        <p class="eyebrow">SSS</p>
        <h2>Sıkça sorulan sorular.</h2>
      </div>
      <p>
        Koçluk yaklaşımı, yapay zekanın rolü ve iade hakkı hakkında en çok merak edilen konular.
      </p>
    </div>
    <div class="container faq-list">
      {faqs.map((faq) => (
        <details class="faq-item">
          <summary>{faq.question}</summary>
          <p>{faq.answer}</p>
        </details>
      ))}
    </div>
  </section>

  <section id="seans" class="trial-section">
    <div class="container trial">
      <div>
        <p class="eyebrow">Koçluk Seansı</p>
        <h2>Size uygun seans paketini seçin.</h2>
        <p>
          Her pakette tüm özellikler aynıdır. İhtiyacınıza göre 4, 10 veya 75 seanslık koçluk paketlerinden birini seçebilirsiniz.
        </p>
      </div>
      <a class="button" href="/fiyatlar">Fiyatları incele</a>
    </div>
  </section>

  <section id="blog">
    <div class="container split-heading">
      <div>
        <p class="eyebrow">Blog</p>
        <h2>Kafanıza takılan konular üzerine yazılar.</h2>
      </div>
      <a class="button-secondary" href="/blog">Tüm Yazılar</a>
    </div>
    <div class="container grid blog-grid">
      {posts.slice(0, 3).map((post) => (
        <article class="card blog-card">
          <a href={`/blog/${getPostSlug(post.id)}/`}>
            <img src={post.data.image} alt="" width="900" height="506" loading="lazy" />
            <div>
              <span>{post.data.category} · {post.data.readTime}</span>
              <h3>{post.data.title}</h3>
              <p>{post.data.description}</p>
            </div>
          </a>
        </article>
      ))}
    </div>
  </section>

  <section id="iletisim" class="contact-section">
    <div class="container contact">
      <div>
        <p class="eyebrow">İletişim</p>
        <h2>Perda İnsan Kaynakları</h2>
        <p>Hayatınızda değiştirmek istediğiniz bir şey var mı? Koçluk seansı hakkında bize ulaşın.</p>
      </div>
      <div class="contact-box scroll-reveal slide-from-right">
        <a href={contactUrl} target="_blank" rel="noopener noreferrer">coach@perda.com.tr</a>
        <span>Akasya Kule, Acıbadem Mah. Üsküdar / İstanbul</span>
        <span>perda.com.tr</span>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  const revealItems = document.querySelectorAll(".scroll-reveal");

  if ("IntersectionObserver" in window) {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add("is-visible");
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.28 },
    );

    revealItems.forEach((item) => observer.observe(item));
  } else {
    revealItems.forEach((item) => item.classList.add("is-visible"));
  }
</script>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.03fr) minmax(320px, 0.97fr);
    min-height: calc(100vh - 82px);
    align-items: center;
    gap: clamp(28px, 5vw, 72px);
    padding-top: clamp(42px, 6vw, 74px);
    padding-bottom: clamp(42px, 6vw, 74px);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 30px;
  }

  .hero-media {
    min-height: 420px;
    overflow: hidden;
    border-radius: 8px;
    box-shadow: var(--shadow);
  }

  .hero-media img {
    width: 100%;
    height: 100%;
    min-height: 420px;
    object-fit: cover;
  }

  .message-band,
  .trial-section {
    color: white;
    background: var(--teal-dark);
  }

  .message-inner,
  .split-heading,
  .privacy-note,
  .trial,
  .contact,
  .habit-panel {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(280px, 0.85fr);
    gap: 32px;
    align-items: center;
  }

  .message-inner h2,
  .message-inner p,
  .trial h2,
  .trial p {
    color: white;
  }

  .split-heading {
    align-items: end;
    margin-bottom: 34px;
  }

  .soft-section,
  .privacy-section {
    background: var(--soft);
  }

  .pain-grid,
  .topic-grid,
  .outcomes-list {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 14px;
  }

  .pain-card,
  .outcomes-list article {
    display: grid;
    min-height: 132px;
    align-items: end;
    border: 1px solid var(--line);
    border-radius: 8px;
    padding: 20px;
    background: white;
    box-shadow: 0 8px 24px rgba(20, 32, 31, 0.06);
  }

  .pain-card p,
  .outcomes-list p {
    color: var(--teal-dark);
    font-weight: 850;
  }

  .topic-grid span {
    border: 1px solid #cbd9d2;
    border-radius: 8px;
    padding: 16px;
    background: rgba(255, 255, 255, 0.78);
    color: #293936;
    font-weight: 800;
  }

  .topic-action {
    margin-top: 24px;
  }

  .habit-section {
    background: #122321;
  }

  .habit-panel h2,
  .habit-panel p,
  .habit-panel blockquote {
    color: white;
  }

  .habit-panel blockquote {
    margin: 0 0 16px;
    border-left: 5px solid var(--coral);
    padding-left: 18px;
    font-size: clamp(1.35rem, 3vw, 2.2rem);
    font-weight: 850;
    line-height: 1.16;
  }

  .privacy-note {
    padding: clamp(30px, 5vw, 52px);
    border-left: 8px solid var(--teal);
    border-radius: 8px;
    background: white;
    box-shadow: var(--shadow);
  }

  .faq-section {
    background: white;
  }

  .faq-list {
    display: grid;
    gap: 12px;
  }

  .faq-item {
    border: 1px solid var(--line);
    border-radius: 8px;
    background: var(--paper);
    box-shadow: 0 8px 24px rgba(20, 32, 31, 0.04);
  }

  .faq-item summary {
    cursor: pointer;
    padding: 20px 22px;
    color: var(--ink);
    font-size: 1.05rem;
    font-weight: 850;
  }

  .faq-item p {
    padding: 0 22px 22px;
  }

  .trial .button {
    justify-self: end;
    background: var(--coral);
  }

  .blog-grid {
    grid-template-columns: repeat(3, 1fr);
  }

  .blog-card {
    overflow: hidden;
  }

  .blog-card img {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }

  .blog-card div {
    display: grid;
    gap: 10px;
    padding: 18px;
  }

  .blog-card span {
    color: var(--coral);
    font-size: 0.82rem;
    font-weight: 800;
  }

  .contact-section {
    background: var(--soft);
  }

  .contact-box {
    display: grid;
    gap: 12px;
    padding: 28px;
    border-radius: 8px;
    background: white;
    box-shadow: 0 8px 24px rgba(20, 32, 31, 0.06);
    font-weight: 700;
  }

  .contact-box a {
    color: var(--teal);
    font-size: 1.2rem;
  }

  .scroll-reveal {
    opacity: 0;
    transition: opacity 620ms ease, transform 620ms cubic-bezier(0.2, 0.8, 0.2, 1);
    will-change: opacity, transform;
  }

  .slide-from-right {
    transform: translateX(42px);
  }

  .scroll-reveal.is-visible {
    opacity: 1;
    transform: translateX(0);
  }

  @media (max-width: 980px) {
    .hero,
    .message-inner,
    .split-heading,
    .privacy-note,
    .trial,
    .contact,
    .habit-panel {
      grid-template-columns: 1fr;
    }

    .hero {
      min-height: auto;
    }

    .pain-grid,
    .topic-grid,
    .outcomes-list,
    .blog-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .trial .button {
      justify-self: start;
    }
  }

  @media (max-width: 620px) {
    .pain-grid,
    .topic-grid,
    .outcomes-list,
    .blog-grid {
      grid-template-columns: 1fr;
    }

    .hero-media,
    .hero-media img {
      min-height: 300px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .scroll-reveal {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>
