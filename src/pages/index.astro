---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const getPostSlug = (id: string) => id.replace(/\.md$/, "");

const emailSubject = "Koçluk seansı hakkında";
const emailBody =
  "Merhaba Perda İnsan Kaynakları,\n\nYapay zeka ile koçluk uygulaması hakkında bilgi almak istiyorum.\n\nAd Soyad:\nTelefon:\nKoçluk odağım:\n";
const contactUrl = `https://mail.google.com/mail/?view=cm&fs=1&to=coach@perda.com.tr&su=${encodeURIComponent(emailSubject)}&body=${encodeURIComponent(emailBody)}`;
const signupUrl = "https://coach.perda.com.tr/accounts/signup/";

const steps = [
  {
    title: "Hedefinizi tarif edin",
    text: "Değiştirmek, netleştirmek veya ilerletmek istediğiniz konuyu birkaç cümleyle başlatın.",
  },
  {
    title: "Yapay zeka koçunuzla görüşün",
    text: "Görüşme, hedefiniz etrafında sorular, yansıtma ve aksiyon seçenekleriyle yapılandırılır.",
  },
  {
    title: "Aksiyon planı alın",
    text: "Seans sonunda kararlarınızı, fark ettiklerinizi ve sonraki adımlarınızı daha net görürsünüz.",
  },
  {
    title: "Bakış açınızı değiştirin",
    text: "Seans sonrası diyalog uygulamasında, benzer konuda destek veren yol gösteren rolüne geçerek konuyu farklı taraftan görürsünüz.",
  },
  {
    title: "Gerçek hikayelerden ilham alın",
    text: "Benzer duygular yaşamış insanların bu süreci nasıl fırsata çevirdiğini anlatan gerçek hikayelerle seansı tamamlayabilirsiniz.",
  },
];

const scopes = [
  "Kariyer hedefleri",
  "Liderlik ve karar alma",
  "İlişki koçluğu",
  "Motivasyon ve alışkanlıklar",
  "İletişim becerileri",
  "İş-yaşam dengesi",
  "Bireysel gelişim",
  "Kurumsal gelişim hedefleri",
];

const afterSessionFeatures = [
  {
    title: "Yol gösteren rolüne geçin",
    text: "Koçluk seansı tamamlandıktan sonra danışan, benzer konuda destek veren kişi rolüne girer. Bu diyalog deneyimi, kişinin kendi konusuna dışarıdan bakmasını ve yeni seçenekleri fark etmesini kolaylaştırır.",
  },
  {
    title: "Gerçek hikayelerle ilham alın",
    text: "Seans sonunda benzer duygular yaşamış insanların gerçek hikayeleri paylaşılır. Danışan, zorlayıcı bir durumu fırsata çevirmiş kişilerin deneyimlerinden ilham alarak kendi adımını daha net düşünebilir.",
  },
];

const coachingGains = [
  "Farkındalık",
  "Somut aksiyon ve egzersiz",
  "Sorunu fırsata çevirmek için ilham",
  "Odağı sorundan çözüme çeviren diyalog",
];

const faqs = [
  {
    question: "Yapısı hazır tavsiye mi veriyor yoksa koçluk mu yapıyor?",
    answer:
      "Aynı sorunu yaşayanların çözümü aynı değildir. Herkesin farklı geçmişi, bakış açıları, inançları ve beklentileri vardır. Yapay zeka koçunuz sizin çözümünüzü sizin bulmanız için size koçluk yapar. Tavsiye vermez, soru sorar.",
  },
  {
    question: "Verilerim güvende mi / yazışmalarımı nasıl silebilirim?",
    answer:
      "Seans bitiminde verileri silebileceğiniz bir buton görünür. Okumanız bittiğinde isterseniz silebilir, isterseniz saklayabilirsiniz. Siz sil demeden yazışmalarınız silinmez.",
  },
  {
    question: "İlk seans sonrası memnun kalmazsam ne olur?",
    answer:
      "İlk koçluk seansınızı tamamladıktan sonra memnun kalmazsanız satın alma tarihinden itibaren 14 gün içinde ödemenin tamamını geri alabilirsiniz. Tekrar eden ödeme ve abonelik yoktur.",
  },
];
---

<BaseLayout
  title="Yapay Zeka ile Koçluk Uygulaması | Perda İnsan Kaynakları"
  description="Perda İnsan Kaynakları, bireysel ve kurumsal hedefler için yapay zeka destekli koçluk seansları sunar. Memnun kalmazsanız ilk seans sonrası 14 gün içinde iade hakkınız vardır."
>
  <section class="hero">
    <div class="hero-copy">
      <p class="eyebrow">Perda İnsan Kaynakları</p>
      <h1>Yapay zeka ile kişisel koçluk deneyimi</h1>
      <p class="lead">
        Hayatınızda değiştirmek istediğiniz bir şey var mı? Perda, bireysel ve kurumsal hedefler için yapılandırılmış, erişilebilir ve insan odaklı bir yapay zeka koçluk uygulamasıdır.
      </p>
      <div class="hero-actions">
        <a class="button" href={signupUrl} target="_blank" rel="noopener noreferrer">Koçluk Seansı Al</a>
        <a class="button-secondary" href="#nasil-calisir">Nasıl Çalışır?</a>
      </div>
    </div>
    <div class="hero-media">
      <img src="/images/hero-ai-coaching.png" alt="Yapay zeka destekli koçluk görüşmesini temsil eden çalışma alanı" width="1536" height="1024" />
    </div>
  </section>

  <section class="message-band">
    <div class="container message-inner">
      <h2>Hayatınızda değiştirmek istediğiniz bir şey var mı?</h2>
      <p>
        Gece 11'de bir mesaj aldınız ve kafanız çok karıştı ya da sabaha karşı 4:00'da endişe içinde uyandınız. Koçunuza her an ulaşmak ister misiniz?
      </p>
    </div>
  </section>

  <section id="nasil-calisir">
    <div class="container split-heading">
      <div>
        <p class="eyebrow">Nasıl Çalışır?</p>
        <h2>Koçluk görüşmesi yapay zeka tarafından yürütülür.</h2>
      </div>
      <p>
        Süreç, hazır cevaplar vermek yerine doğru sorularla düşünmenizi, önceliklerinizi ayırmanızı ve uygulanabilir adımlar oluşturmanızı destekler.
      </p>
    </div>
    <div class="container grid step-grid">
      {steps.map((step, index) => (
        <article class="card step-card">
          <span>{String(index + 1).padStart(2, "0")}</span>
          <h3>{step.title}</h3>
          <p>{step.text}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="outcomes-section">
    <div class="container split-heading">
      <div>
        <p class="eyebrow">Dakikalar İçinde</p>
        <h2>Yapay zeka koçunuz 7-10 soruyla odağınızı netleştirir.</h2>
      </div>
      <p>
        Perda, uzun hazırlık gerektirmeden sizi dinleyen, doğru sorularla düşünmenizi sağlayan ve seans sonunda uygulanabilir bir yön sunan kısa ama yapılandırılmış bir deneyim sunar.
      </p>
    </div>
    <div class="container outcomes-list">
      {coachingGains.map((gain) => <span>{gain}</span>)}
    </div>
  </section>

  <section id="kapsam" class="soft-section">
    <div class="container split-heading">
      <div>
        <p class="eyebrow">Koçluk Kapsamı</p>
        <h2>Bireysel ve kurumsal hedeflere uyumlu esnek kullanım.</h2>
      </div>
      <p>
        Perda, tek bir alana sıkışmadan kariyer, liderlik, ilişki koçluğu ve gündelik karar süreçleri gibi farklı gelişim başlıklarında kullanılabilir.
      </p>
    </div>
    <div class="container scope-list">
      {scopes.map((scope) => <span>{scope}</span>)}
    </div>
  </section>

  <section>
    <div class="container split-heading">
      <div>
        <p class="eyebrow">Seans Sonrası Deneyim</p>
        <h2>Görüşme bitince düşünme süreci devam eder.</h2>
      </div>
      <p>
        Perda, koçluk seansını yalnızca soru-cevap görüşmesi olarak bırakmaz. Danışanın bakış açısını genişletmesini ve yaşadığı durumu yeni bir anlamla ele almasını destekleyen iki tamamlayıcı uygulama sunar.
      </p>
    </div>
    <div class="container grid after-session-grid">
      {afterSessionFeatures.map((feature) => (
        <article class="card after-session-card">
          <h3>{feature.title}</h3>
          <p>{feature.text}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="privacy-section">
    <div class="container privacy-note">
      <div>
        <p class="eyebrow">Gizlilik Kontrolü</p>
        <h2>Seans bitiminde yazışmalarınızı silebilirsiniz.</h2>
      </div>
      <p>
        Koçluk görüşmesi kişisel bir alandır. Perda'da danışan, seans tamamlandıktan sonra tüm seans yazışmalarını silebilir; böylece görüşme sonrası veri kontrolü kullanıcıda kalır.
      </p>
    </div>
  </section>

  <section class="faq-section">
    <div class="container split-heading">
      <div>
        <p class="eyebrow">SSS</p>
        <h2>Sıkça sorulan sorular.</h2>
      </div>
      <p>
        Koçluk yaklaşımı, veri kontrolü ve ilk seans sonrası iade hakkı hakkında en çok merak edilen konular.
      </p>
    </div>
    <div class="container faq-list">
      {faqs.map((faq) => (
        <details class="faq-item">
          <summary>{faq.question}</summary>
          <p>{faq.answer}</p>
        </details>
      ))}
    </div>
  </section>

  <section id="seans" class="trial-section">
    <div class="container trial">
      <div>
        <p class="eyebrow">Koçluk Seansı</p>
        <h2>İlk seansı tamamlayın; memnun kalmazsanız ödemenizi geri alın.</h2>
        <p>
          Satın alma tarihinden itibaren 14 gün içinde iade hakkınız vardır. Abonelik yoktur; seans paketlerini ihtiyaç duydukça satın alırsınız.
        </p>
      </div>
      <a class="button" href={signupUrl} target="_blank" rel="noopener noreferrer">Hesap oluştur</a>
    </div>
  </section>

  <section id="blog">
    <div class="container split-heading">
      <div>
        <p class="eyebrow">Blog</p>
        <h2>Yapay zeka, koçluk ve gelişim üzerine örnek içerikler.</h2>
      </div>
      <a class="button-secondary" href="/blog">Tüm Yazılar</a>
    </div>
    <div class="container grid blog-grid">
      {posts.slice(0, 3).map((post) => (
        <article class="card blog-card">
          <a href={`/blog/${getPostSlug(post.id)}/`}>
            <img src={post.data.image} alt="" width="900" height="506" loading="lazy" />
            <div>
              <span>{post.data.category} · {post.data.readTime}</span>
              <h3>{post.data.title}</h3>
              <p>{post.data.description}</p>
            </div>
          </a>
        </article>
      ))}
    </div>
  </section>

  <section id="iletisim" class="contact-section">
    <div class="container contact">
      <div>
        <p class="eyebrow">İletişim</p>
        <h2>Perda İnsan Kaynakları</h2>
        <p>Hayatınızda değiştirmek istediğiniz bir şey var mı? Koçluk seansı hakkında bize ulaşın.</p>
      </div>
      <div class="contact-box scroll-reveal slide-from-right">
        <a href={contactUrl} target="_blank" rel="noopener noreferrer">coach@perda.com.tr</a>
        <span>Akasya Kule, Acıbadem Mah. Üsküdar / İstanbul</span>
        <span>perda.com.tr</span>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  const revealItems = document.querySelectorAll(".scroll-reveal");

  if ("IntersectionObserver" in window) {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add("is-visible");
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.28 },
    );

    revealItems.forEach((item) => observer.observe(item));
  } else {
    revealItems.forEach((item) => item.classList.add("is-visible"));
  }
</script>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.03fr) minmax(320px, 0.97fr);
    min-height: calc(100vh - 82px);
    align-items: center;
    gap: clamp(28px, 5vw, 72px);
    padding-top: clamp(42px, 6vw, 74px);
    padding-bottom: clamp(42px, 6vw, 74px);
  }

  .hero-copy {
    width: min(100%, 900px);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 30px;
  }

  .hero-media {
    min-height: 420px;
    overflow: hidden;
    border-radius: 8px;
    box-shadow: var(--shadow);
  }

  .hero-media img {
    width: 100%;
    height: 100%;
    min-height: 420px;
    object-fit: cover;
  }

  .message-band {
    padding-top: 42px;
    padding-bottom: 42px;
    color: white;
    background: var(--teal-dark);
  }

  .message-inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 28px;
    align-items: center;
  }

  .message-inner p,
  .message-inner h2 {
    color: white;
  }

  .split-heading {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(280px, 0.8fr);
    gap: 32px;
    align-items: end;
    margin-bottom: 34px;
  }

  .step-grid {
    grid-template-columns: repeat(5, 1fr);
  }

  .step-card {
    min-height: 260px;
    padding: 24px;
  }

  .step-card span {
    display: inline-block;
    margin-bottom: 46px;
    color: var(--coral);
    font-weight: 850;
  }

  .step-card h3 {
    margin-bottom: 12px;
  }

  .soft-section {
    background: var(--soft);
  }

  .outcomes-section {
    background: white;
  }

  .outcomes-list {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 14px;
  }

  .outcomes-list span {
    display: grid;
    min-height: 112px;
    align-items: center;
    border: 1px solid var(--line);
    border-radius: 8px;
    padding: 18px;
    background: var(--soft);
    color: var(--teal-dark);
    font-size: 1.05rem;
    font-weight: 800;
  }

  .scope-list {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .scope-list span {
    border: 1px solid #cbd9d2;
    border-radius: 999px;
    padding: 12px 16px;
    background: rgba(255, 255, 255, 0.72);
    color: #293936;
    font-weight: 700;
  }

  .after-session-grid {
    grid-template-columns: repeat(2, 1fr);
  }

  .after-session-card {
    min-height: 250px;
    padding: clamp(24px, 4vw, 38px);
    border-top: 6px solid var(--coral);
  }

  .after-session-card h3 {
    margin-bottom: 14px;
    font-size: clamp(1.35rem, 2.5vw, 2rem);
  }

  .privacy-section {
    background: var(--soft);
  }

  .privacy-note {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: 34px;
    align-items: center;
    padding: clamp(30px, 5vw, 52px);
    border-left: 8px solid var(--teal);
    border-radius: 8px;
    background: white;
    box-shadow: var(--shadow);
  }

  .faq-section {
    background: white;
  }

  .faq-list {
    display: grid;
    gap: 12px;
  }

  .faq-item {
    border: 1px solid var(--line);
    border-radius: 8px;
    background: var(--paper);
    box-shadow: 0 8px 24px rgba(20, 32, 31, 0.04);
  }

  .faq-item summary {
    cursor: pointer;
    padding: 20px 22px;
    color: var(--ink);
    font-size: 1.05rem;
    font-weight: 850;
  }

  .faq-item p {
    padding: 0 22px 22px;
  }

  .trial-section {
    background: #122321;
  }

  .trial {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 30px;
    align-items: center;
  }

  .trial h2,
  .trial p {
    color: white;
  }

  .trial .button {
    background: var(--coral);
  }

  .trial .button:hover {
    background: #ad543c;
  }

  .blog-grid {
    grid-template-columns: repeat(3, 1fr);
  }

  .blog-card {
    overflow: hidden;
  }

  .blog-card img {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }

  .blog-card div {
    display: grid;
    gap: 10px;
    padding: 18px;
  }

  .blog-card span {
    color: var(--coral);
    font-size: 0.82rem;
    font-weight: 800;
  }

  .contact-section {
    background: var(--soft);
  }

  .contact {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 28px;
    align-items: center;
  }

  .contact-box {
    display: grid;
    gap: 12px;
    padding: 28px;
    border-radius: 8px;
    background: white;
    box-shadow: 0 8px 24px rgba(20, 32, 31, 0.06);
    font-weight: 700;
  }

  .contact-box a {
    color: var(--teal);
    font-size: 1.2rem;
  }

  .scroll-reveal {
    opacity: 0;
    transition: opacity 620ms ease, transform 620ms cubic-bezier(0.2, 0.8, 0.2, 1);
    will-change: opacity, transform;
  }

  .slide-from-right {
    transform: translateX(42px);
  }

  .scroll-reveal.is-visible {
    opacity: 1;
    transform: translateX(0);
  }

  @media (max-width: 980px) {
    .hero,
    .message-inner,
    .split-heading,
    .privacy-note,
    .trial,
    .contact {
      grid-template-columns: 1fr;
    }

    .hero {
      min-height: auto;
    }

    .step-grid,
    .after-session-grid,
    .outcomes-list,
    .blog-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .trial .button {
      justify-self: start;
    }
  }

  @media (max-width: 620px) {
    .step-grid,
    .after-session-grid,
    .outcomes-list,
    .blog-grid {
      grid-template-columns: 1fr;
    }

    .hero-media,
    .hero-media img {
      min-height: 300px;
    }

    .step-card {
      min-height: auto;
    }

    .step-card span {
      margin-bottom: 24px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .scroll-reveal {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>
