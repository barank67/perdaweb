---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const getPostSlug = (id: string) => id.replace(/\.md$/, "");

const emailSubject = "Ücretsiz deneme seansı talebi";
const emailBody =
  "Merhaba Perda İnsan Kaynakları,\n\nYapay zeka ile koçluk uygulaması için ücretsiz deneme seansı talep ediyorum.\n\nAd Soyad:\nTelefon:\nKoçluk odağım:\n";
const contactUrl = `https://mail.google.com/mail/?view=cm&fs=1&to=coach@perda.com.tr&su=${encodeURIComponent(emailSubject)}&body=${encodeURIComponent(emailBody)}`;

const steps = [
  {
    title: "Hedefinizi tarif edin",
    text: "Değiştirmek, netleştirmek veya ilerletmek istediğiniz konuyu birkaç cümleyle başlatın.",
  },
  {
    title: "Yapay zeka koçunuzla görüşün",
    text: "Görüşme, hedefiniz etrafında sorular, yansıtma ve aksiyon seçenekleriyle yapılandırılır.",
  },
  {
    title: "Aksiyon planı alın",
    text: "Seans sonunda kararlarınızı, fark ettiklerinizi ve sonraki adımlarınızı daha net görürsünüz.",
  },
  {
    title: "İsterseniz süpervizör ekleyin",
    text: "Gerçek koç desteği, ana koçluk yerine değil, süreci değerlendiren ek katkı olarak konumlanır.",
  },
];

const scopes = [
  "Kariyer hedefleri",
  "Liderlik ve karar alma",
  "İlişki koçluğu",
  "Motivasyon ve alışkanlıklar",
  "İletişim becerileri",
  "İş-yaşam dengesi",
  "Bireysel gelişim",
  "Kurumsal gelişim hedefleri",
];
---

<BaseLayout
  title="Yapay Zeka ile Koçluk Uygulaması | Perda İnsan Kaynakları"
  description="Perda İnsan Kaynakları, bireysel ve kurumsal hedefler için yapay zeka destekli koçluk deneyimi sunar. Kısa süre için ücretsiz tek seans deneyin."
>
  <section class="hero">
    <div class="hero-copy">
      <p class="eyebrow">Perda İnsan Kaynakları</p>
      <h1>Yapay zeka ile kişisel koçluk deneyimi</h1>
      <p class="lead">
        Hayatınızda değiştirmek istediğiniz bir şey var mı? Perda, bireysel ve kurumsal hedefler için yapılandırılmış, erişilebilir ve insan odaklı bir yapay zeka koçluk uygulamasıdır.
      </p>
      <div class="hero-actions">
        <a class="button" href={contactUrl} target="_blank" rel="noopener noreferrer">Ücretsiz Deneme Seansı Al</a>
        <a class="button-secondary" href="#nasil-calisir">Nasıl Çalışır?</a>
      </div>
    </div>
    <div class="hero-media">
      <img src="/images/hero-ai-coaching.png" alt="Yapay zeka destekli koçluk görüşmesini temsil eden çalışma alanı" width="1536" height="1024" />
    </div>
  </section>

  <section class="message-band">
    <div class="container message-inner">
      <h2>Hayatınızda değiştirmek istediğiniz bir şey var mı?</h2>
      <p>
        İlk sürümümüz test aşamasında. Kısa süre için ücretsiz tek seans deneme hakkıyla uygulamayı deneyebilir, size uygun gelişim odağını birlikte netleştirebilirsiniz.
      </p>
    </div>
  </section>

  <section id="nasil-calisir">
    <div class="container split-heading">
      <div>
        <p class="eyebrow">Nasıl Çalışır?</p>
        <h2>Koçluk görüşmesi yapay zeka tarafından yürütülür.</h2>
      </div>
      <p>
        Süreç, hazır cevaplar vermek yerine doğru sorularla düşünmenizi, önceliklerinizi ayırmanızı ve uygulanabilir adımlar oluşturmanızı destekler.
      </p>
    </div>
    <div class="container grid step-grid">
      {steps.map((step, index) => (
        <article class="card step-card">
          <span>{String(index + 1).padStart(2, "0")}</span>
          <h3>{step.title}</h3>
          <p>{step.text}</p>
        </article>
      ))}
    </div>
  </section>

  <section id="kapsam" class="soft-section">
    <div class="container split-heading">
      <div>
        <p class="eyebrow">Koçluk Kapsamı</p>
        <h2>Bireysel ve kurumsal hedeflere uyumlu esnek kullanım.</h2>
      </div>
      <p>
        Perda, tek bir alana sıkışmadan kariyer, liderlik, ilişki koçluğu ve gündelik karar süreçleri gibi farklı gelişim başlıklarında kullanılabilir.
      </p>
    </div>
    <div class="container scope-list">
      {scopes.map((scope) => <span>{scope}</span>)}
    </div>
  </section>

  <section>
    <div class="container supervisor">
      <div>
        <p class="eyebrow">Süpervizör Koç Seçeneği</p>
        <h2>İsterseniz gerçek koçtan ek katkı alabilirsiniz.</h2>
      </div>
      <p>
        Ana koçluk deneyimi tamamen yapay zeka tarafından yapılır. Gerçek koç, kullanıcı talep ettiğinde sürece süpervizör olarak katkı verir; görüşmenin odağını, aksiyon planını veya gelişim yönünü değerlendirebilir.
      </p>
    </div>
  </section>

  <section id="deneme" class="trial-section">
    <div class="container trial">
      <div>
        <p class="eyebrow">Ücretsiz Tek Seans</p>
        <h2>Test aşamasındaki uygulamayı kısa süre için ücretsiz deneyin.</h2>
        <p>
          Talebinizi e-posta ile iletin. Size deneme seansı için dönüş yapılır ve uygun koçluk odağı belirlenir.
        </p>
      </div>
      <a class="button" href={contactUrl} target="_blank" rel="noopener noreferrer">coach@perda.com.tr adresine başvur</a>
    </div>
  </section>

  <section id="blog">
    <div class="container split-heading">
      <div>
        <p class="eyebrow">Blog</p>
        <h2>Yapay zeka, koçluk ve gelişim üzerine örnek içerikler.</h2>
      </div>
      <a class="button-secondary" href="/blog">Tüm Yazılar</a>
    </div>
    <div class="container grid blog-grid">
      {posts.slice(0, 3).map((post) => (
        <article class="card blog-card">
          <a href={`/blog/${getPostSlug(post.id)}/`}>
            <img src={post.data.image} alt="" width="900" height="506" loading="lazy" />
            <div>
              <span>{post.data.category} · {post.data.readTime}</span>
              <h3>{post.data.title}</h3>
              <p>{post.data.description}</p>
            </div>
          </a>
        </article>
      ))}
    </div>
  </section>

  <section id="iletisim" class="contact-section">
    <div class="container contact">
      <div>
        <p class="eyebrow">İletişim</p>
        <h2>Perda İnsan Kaynakları</h2>
        <p>Hayatınızda değiştirmek istediğiniz bir şey var mı? Deneme seansı talebinizi bize iletin.</p>
      </div>
      <div class="contact-box">
        <a href={contactUrl} target="_blank" rel="noopener noreferrer">coach@perda.com.tr</a>
        <span>Akasya Kule, Acıbadem Mah. Üsküdar / İstanbul</span>
        <span>perda.com.tr</span>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.03fr) minmax(320px, 0.97fr);
    min-height: calc(100vh - 82px);
    align-items: center;
    gap: clamp(28px, 5vw, 72px);
    padding-top: clamp(42px, 6vw, 74px);
    padding-bottom: clamp(42px, 6vw, 74px);
  }

  .hero-copy {
    width: min(100%, 900px);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 30px;
  }

  .hero-media {
    min-height: 420px;
    overflow: hidden;
    border-radius: 8px;
    box-shadow: var(--shadow);
  }

  .hero-media img {
    width: 100%;
    height: 100%;
    min-height: 420px;
    object-fit: cover;
  }

  .message-band {
    padding-top: 42px;
    padding-bottom: 42px;
    color: white;
    background: var(--teal-dark);
  }

  .message-inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 28px;
    align-items: center;
  }

  .message-inner p,
  .message-inner h2 {
    color: white;
  }

  .split-heading {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(280px, 0.8fr);
    gap: 32px;
    align-items: end;
    margin-bottom: 34px;
  }

  .step-grid {
    grid-template-columns: repeat(4, 1fr);
  }

  .step-card {
    min-height: 260px;
    padding: 24px;
  }

  .step-card span {
    display: inline-block;
    margin-bottom: 46px;
    color: var(--coral);
    font-weight: 850;
  }

  .step-card h3 {
    margin-bottom: 12px;
  }

  .soft-section {
    background: var(--soft);
  }

  .scope-list {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .scope-list span {
    border: 1px solid #cbd9d2;
    border-radius: 999px;
    padding: 12px 16px;
    background: rgba(255, 255, 255, 0.72);
    color: #293936;
    font-weight: 700;
  }

  .supervisor {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: 34px;
    padding: clamp(34px, 5vw, 58px);
    border-left: 8px solid var(--coral);
    background: white;
    box-shadow: var(--shadow);
  }

  .trial-section {
    background: #122321;
  }

  .trial {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 30px;
    align-items: center;
  }

  .trial h2,
  .trial p {
    color: white;
  }

  .trial .button {
    background: var(--coral);
  }

  .trial .button:hover {
    background: #ad543c;
  }

  .blog-grid {
    grid-template-columns: repeat(3, 1fr);
  }

  .blog-card {
    overflow: hidden;
  }

  .blog-card img {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }

  .blog-card div {
    display: grid;
    gap: 10px;
    padding: 18px;
  }

  .blog-card span {
    color: var(--coral);
    font-size: 0.82rem;
    font-weight: 800;
  }

  .contact-section {
    background: var(--soft);
  }

  .contact {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 28px;
    align-items: center;
  }

  .contact-box {
    display: grid;
    gap: 12px;
    padding: 28px;
    border-radius: 8px;
    background: white;
    box-shadow: 0 8px 24px rgba(20, 32, 31, 0.06);
    font-weight: 700;
  }

  .contact-box a {
    color: var(--teal);
    font-size: 1.2rem;
  }

  @media (max-width: 980px) {
    .hero,
    .message-inner,
    .split-heading,
    .supervisor,
    .trial,
    .contact {
      grid-template-columns: 1fr;
    }

    .hero {
      min-height: auto;
    }

    .step-grid,
    .blog-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .trial .button {
      justify-self: start;
    }
  }

  @media (max-width: 620px) {
    .step-grid,
    .blog-grid {
      grid-template-columns: 1fr;
    }

    .hero-media,
    .hero-media img {
      min-height: 300px;
    }

    .step-card {
      min-height: auto;
    }

    .step-card span {
      margin-bottom: 24px;
    }
  }
</style>
