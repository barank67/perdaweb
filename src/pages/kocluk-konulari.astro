---
import BaseLayout from "../layouts/BaseLayout.astro";

const categories = [
  {
    title: "Sınır Koyma ve Kendini İfade Etme",
    items: [
      ["Hayır diyemiyorum.", "İnsanları kırmamak için kabul ettiğiniz taleplerin sizi yorduğunu fark ediyor ve sınırlarınızı suçluluk duymadan korumak istiyorsunuz."],
      ["İnsanların benim hakkımda ne düşündüğünü fazla önemsiyorum.", "Kendi isteğinizden çok çevreden gelecek tepkileri hesaplıyor ve onaya ihtiyaç duymadan seçim yapabilmek istiyorsunuz."],
      ["Toplantılarda fikirlerimi söyleyemiyorum.", "Yanlış bulunmaktan çekindiğiniz için geri planda kalıyor ve kendinizi daha net ortaya koymak istiyorsunuz."],
      ["İnsanlardan yardım istemekte zorlanıyorum.", "Destek istemeyi güçsüzlük gibi değil, doğal bir iş birliği olarak görebilmek istiyorsunuz."],
      ["Yardım tekliflerini geri çeviriyorum ama yalnız bırakıldığımda kırılıyorum.", "İhtiyaçlarınızı doğrudan ifade etmeyi ve beklentilerinizi daha açık kurmayı öğrenmek istiyorsunuz."],
    ],
  },
  {
    title: "Erteleme, Mükemmeliyetçilik ve Harekete Geçme",
    items: [
      ["Bir işe başlamak için kendimi hazır hissetmeyi bekliyorum.", "Yeterli bilgi, zaman veya güven oluşmadan da küçük bir adım atabilmek istiyorsunuz."],
      ["Her şeyi kusursuz yapmaya çalışıyorum.", "Hata ihtimali yüzünden işleri uzatıyor veya yayımlamıyor, yeterince iyi olanı kabul etmek istiyorsunuz."],
      ["Önemli işleri erteliyor, küçük işlerle oyalanıyorum.", "Meşgul olmak yerine gerçekten önemli hedeflerinizi ilerletecek bir düzen kurmak istiyorsunuz."],
      ["Başladığım projeleri tamamlayamıyorum.", "İlk heyecan geçtikten sonra da devam edebilmek ve sonuç almak istiyorsunuz."],
      ["Hayatımda bir değişiklik yapmak istediğimi biliyorum ama ilk adımı bulamıyorum.", "Büyük dönüşüm baskısı yerine kontrolünüzde olan küçük ve anlamlı ilk adımı belirlemek istiyorsunuz."],
    ],
  },
  {
    title: "Kariyer Yönü ve Görünürlük",
    items: [
      ["İş değiştirmek istiyorum ama hangi yöne gideceğimi bilmiyorum.", "Değerlerinize ve yeteneklerinize uygun bir kariyer yönü belirlemek istiyorsunuz."],
      ["Terfi istemekten çekiniyorum.", "Katkınızı açıkça ifade edip unvan ve ücret konuşmalarını daha rahat yapabilmek istiyorsunuz."],
      ["Kazancımı artırmak istiyorum ama kendimi göstermekten çekiniyorum.", "Değerinizi abartmadan görünür olmak ve teklif sunabilmek istiyorsunuz."],
      ["Kendi işimi kurmakla güvenceli işimde kalmak arasında kararsızım.", "Özgürlük isteği ile güvenlik ihtiyacını gerçekçi biçimde değerlendirip geçiş planı oluşturmak istiyorsunuz."],
      ["Bir fikrin doğru olup olmadığını anlamadan ona fazla bağlanıyorum.", "Fikrinizi egonuzdan ayırarak geliştirme, değiştirme veya bırakma kararını daha sakin vermek istiyorsunuz."],
    ],
  },
  {
    title: "Liderlik, Ekip ve Zor Geri Bildirim",
    items: [
      ["Eleştiri aldığımda hemen savunmaya geçiyorum.", "Geri bildirimi kişisel saldırı gibi algılamadan dinleyebilmek istiyorsunuz."],
      ["İşleri devredemiyorum.", "Kontrolü tamamen kaybetmeden sorumluluk paylaşmayı ve tükenmeden ilerlemeyi öğrenmek istiyorsunuz."],
      ["Yönetici olduğumdan beri eski çalışma arkadaşlarımla sınır koyamıyorum.", "Hem insani hem de kararlı bir yönetici olmak istiyorsunuz."],
      ["Ekibimdeki çatışmaları üzerime alıyorum.", "Herkesin duygusal yükünü taşımadan liderlik edebilmek istiyorsunuz."],
      ["İşletmemde her işi kendim yapıyorum.", "Hangi işleri bırakmanız gerektiğine karar verip büyümeye alan açmak istiyorsunuz."],
    ],
  },
  {
    title: "İş-Yaşam Dengesi ve Tükenmişlik",
    items: [
      ["İşim bütün hayatımı kaplıyor.", "İşinize önem verirken özel hayatınıza da gerçek bir alan açmak istiyorsunuz."],
      ["Yoğun olmadığımda verimsiz hissediyorum.", "Meşgul olmakla değer üretmek arasındaki farkı daha sağlıklı kurmak istiyorsunuz."],
